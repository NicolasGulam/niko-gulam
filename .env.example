# Contact form delivery (SMTP). Copy this file to `.env.local` and fill it in.
# Any mailbox/provider that offers SMTP works (Google Workspace, Zoho, Hostinger,
# Resend SMTP, ...). Never commit real credentials.

# Server and credentials of the mailbox used to SEND the notification.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465). Leave unset for STARTTLS on 587.
SMTP_SECURE=
SMTP_USER=nk@ntk.solutions
SMTP_PASS=

# Where messages are delivered (defaults to nk@ntk.solutions).
CONTACT_TO=nk@ntk.solutions
# Optional "from" address (defaults to SMTP_USER).
CONTACT_FROM=
